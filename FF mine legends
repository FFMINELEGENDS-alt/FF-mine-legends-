<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>FF Mine Legends | Gaming Store</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#080808;
    color:white;
}

/* HEADER */

header{
    height:70px;
    padding:0 18px;
    display:flex;
    align-items:center;
    justify-content:space-between;

    background:rgba(10,10,10,0.95);
    border-bottom:1px solid #333;

    position:sticky;
    top:0;
    z-index:100;
}

.logo{
    font-size:19px;
    font-weight:bold;
}

.logo span{
    color:#00e5ff;
}

.cart{
    background:#00e5ff;
    color:#000;
    padding:9px 14px;
    border-radius:8px;
    font-weight:bold;
}


/* HERO */

.hero{

    min-height:520px;

    padding:60px 22px;

    display:flex;
    flex-direction:column;
    justify-content:center;

    background:

    linear-gradient(
        rgba(0,0,0,0.35),
        rgba(0,0,0,0.80)
    ),

    url("https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1600&q=85");

    background-size:cover;
    background-position:center;
    background-repeat:no-repeat;
}

.hero small{
    color:#00e5ff;
    font-weight:bold;
    letter-spacing:2px;
    margin-bottom:15px;
}

.hero h1{
    font-size:45px;
    line-height:1.05;
    margin-bottom:20px;
}

.hero h1 span{
    color:#00e5ff;
}

.hero p{
    color:#ddd;
    line-height:1.6;
    max-width:450px;
    margin-bottom:28px;
}

.shop-btn{

    width:max-content;

    padding:14px 24px;

    background:#00e5ff;
    color:#000;

    text-decoration:none;

    border-radius:8px;

    font-weight:bold;

    box-shadow:0 0 20px rgba(0,229,255,0.5);
}

.shop-btn:hover{
    transform:scale(1.05);
}


/* SECTION */

.section{

    padding:35px 18px;
    max-width:1100px;
    margin:auto;
}

.section h2{
    font-size:25px;
    margin-bottom:20px;
}


/* CATEGORIES */

.categories{

    display:grid;

    grid-template-columns:
    repeat(2,1fr);

    gap:12px;
}

.category{

    padding:25px 12px;

    background:#151515;

    border:1px solid #292929;

    border-radius:12px;

    text-align:center;
}

.category .icon{

    font-size:38px;

    margin-bottom:10px;
}

.category p{

    color:#999;

    font-size:13px;

    margin-top:5px;
}


/* PRODUCTS */

.products{

    display:grid;

    grid-template-columns:
    repeat(2,1fr);

    gap:12px;
}

.product{

    background:#151515;

    border:1px solid #292929;

    border-radius:12px;

    overflow:hidden;
}

.product-img{

    height:140px;

    display:flex;

    align-items:center;

    justify-content:center;

    background:
    linear-gradient(
        135deg,
        #202020,
        #0c0c0c
    );

    font-size:55px;
}

.product-info{

    padding:14px;
}

.product-info h3{

    font-size:15px;

    margin-bottom:8px;
}

.price{

    color:#00e5ff;

    font-weight:bold;

    margin-bottom:10px;
}

.buy-btn{

    width:100%;

    padding:10px;

    border:none;

    border-radius:7px;

    background:#00e5ff;

    color:#000;

    font-weight:bold;

    cursor:pointer;
}


/* WHY */

.why{

    display:grid;

    gap:12px;
}

.why-box{

    background:#151515;

    padding:18px;

    border-radius:10px;

    border:1px solid #292929;
}

.why-box h3{

    margin-bottom:7px;
}

.why-box p{

    color:#aaa;

    font-size:14px;
}


/* FOOTER */

footer{

    text-align:center;

    padding:35px 15px;

    background:#111;

    color:#777;

    margin-top:20px;
}

footer strong{

    color:#00e5ff;

}


/* DESKTOP */

@media(min-width:700px){

    .hero{

        padding-left:10%;

    }

    .categories{

        grid-template-columns:
        repeat(4,1fr);

    }

    .products{

        grid-template-columns:
        repeat(4,1fr);

    }

}

</style>

</head>


